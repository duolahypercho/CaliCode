{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CaliCode",
  "version": "0.1.0",
  "identifier": "com.calicode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5199"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CaliCode",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cali-core"],
    "resources": ["resources/dist"]
  }
}
